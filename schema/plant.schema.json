{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "plant.schema.json",
  "title": "PlantCraft plant file",
  "description": "One file per species. Sections are filled in by successive phases: data, graphics, implementation, use.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "status",
    "taxonomy",
    "names",
    "description",
    "habitat",
    "growth_stages",
    "reproduction",
    "sources",
    "implementation"
  ],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[a-z]+_[a-z]+(_[a-z]+)?$",
      "description": "genus_species, or genus_species_subspecies, lowercase. Must match the filename."
    },
    "status": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "data",
        "graphics",
        "implementation",
        "use"
      ],
      "properties": {
        "data": {
          "enum": [
            "pending",
            "draft",
            "verified"
          ]
        },
        "graphics": {
          "enum": [
            "pending",
            "in_progress",
            "done"
          ]
        },
        "implementation": {
          "enum": [
            "pending",
            "in_progress",
            "done"
          ]
        },
        "use": {
          "enum": [
            "not_applicable",
            "pending",
            "in_progress",
            "done"
          ]
        }
      }
    },
    "confidence": {
      "enum": [
        "low",
        "medium",
        "high"
      ],
      "description": "How much the facts in this file are trusted until verified against sources."
    },
    "taxonomy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "genus",
        "species",
        "family"
      ],
      "properties": {
        "kingdom": {
          "type": "string"
        },
        "clade": {
          "type": "string"
        },
        "order": {
          "type": "string"
        },
        "family": {
          "type": "string"
        },
        "genus": {
          "type": "string"
        },
        "species": {
          "type": "string"
        },
        "authority": {
          "type": "string"
        },
        "synonyms": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "subspecies": {
          "type": "string"
        }
      }
    },
    "names": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "scientific",
        "common"
      ],
      "properties": {
        "scientific": {
          "type": "string"
        },
        "common": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string"
          }
        },
        "in_game": {
          "type": "string",
          "description": "Display name used in game. Latin name appears in the tooltip."
        }
      }
    },
    "description": {
      "type": "string"
    },
    "habitat": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "native_range",
        "environment"
      ],
      "properties": {
        "native_range": {
          "type": "string"
        },
        "introduced_range": {
          "type": "string"
        },
        "environment": {
          "type": "string"
        },
        "climate": {
          "type": "string"
        },
        "life_form": {
          "enum": [
            "alga",
            "annual_herb",
            "perennial_herb",
            "shrub",
            "vine",
            "tree"
          ]
        },
        "height_m": {
          "type": "string"
        },
        "native_regions": {
          "type": "array",
          "description": "Regions where the plant grows natively, from the World Checklist of Vascular Plants via GBIF (TDWG level-3 regions).",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "region",
              "source"
            ],
            "properties": {
              "region": {
                "type": "string"
              },
              "code": {
                "type": "string",
                "description": "TDWG/WGSRPD region code, e.g. MOR."
              },
              "source": {
                "type": "string"
              }
            }
          }
        },
        "introduced_regions": {
          "type": "array",
          "description": "Regions where it is introduced (not native), same source.",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "region",
              "source"
            ],
            "properties": {
              "region": {
                "type": "string"
              },
              "code": {
                "type": "string"
              },
              "source": {
                "type": "string"
              },
              "status": {
                "type": "string"
              }
            }
          }
        },
        "range_notes": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "Caveats about the range data (source, completeness, wikidata taxon range)."
        }
      }
    },
    "growth_stages": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "name",
          "description"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z_]+$"
          },
          "name": {
            "type": "string"
          },
          "description": {
            "type": "string",
            "description": "What the plant looks like here; the graphics phase works from this."
          },
          "visual_notes": {
            "type": "string"
          },
          "texture": {
            "type": "string",
            "description": "Planned texture path; filled by the graphics phase."
          }
        }
      }
    },
    "reproduction": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "flowers",
        "fruit"
      ],
      "properties": {
        "flowers": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "present"
          ],
          "properties": {
            "present": {
              "type": "boolean"
            },
            "colors": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "opens": {
              "enum": [
                "day",
                "night",
                "morning_only",
                "continuous",
                "not_applicable"
              ]
            },
            "season": {
              "type": "string"
            },
            "pollination": {
              "type": "array",
              "items": {
                "enum": [
                  "bees",
                  "moths",
                  "other_insects",
                  "wind",
                  "self",
                  "water",
                  "not_applicable"
                ]
              }
            },
            "notes": {
              "type": "string"
            }
          }
        },
        "fruit": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "present"
          ],
          "properties": {
            "present": {
              "type": "boolean"
            },
            "type": {
              "type": "string"
            },
            "description": {
              "type": "string"
            },
            "ripening": {
              "type": "string"
            },
            "edible": {
              "enum": [
                "yes",
                "no",
                "toxic",
                "not_applicable"
              ]
            }
          }
        }
      }
    },
    "uses_real": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "use",
          "note"
        ],
        "properties": {
          "use": {
            "type": "string"
          },
          "note": {
            "type": "string"
          },
          "category": {
            "enum": [
              "food",
              "medicine",
              "material",
              "fuel",
              "ornamental",
              "cultural",
              "ecological",
              "forage",
              "toxic",
              "research",
              "other"
            ]
          },
          "part_used": {
            "type": "string"
          },
          "quote": {
            "type": "string",
            "description": "Verbatim text from the source that supports this fact (checked by the pipeline)."
          }
        }
      }
    },
    "images": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "url",
          "license",
          "author",
          "shows"
        ],
        "properties": {
          "url": {
            "type": "string"
          },
          "license": {
            "type": "string"
          },
          "author": {
            "type": "string"
          },
          "shows": {
            "type": "string",
            "description": "Which growth stage or feature this reference photo shows."
          },
          "role": {
            "enum": [
              "flower",
              "fruit",
              "seed",
              "leaf",
              "bark",
              "branches",
              "illustration",
              "habit"
            ]
          },
          "file": {
            "type": "string",
            "description": "Local path of the downloaded photo (data/photos/<id>/...)."
          },
          "width": {
            "type": "integer"
          },
          "height": {
            "type": "integer"
          },
          "hints": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        }
      }
    },
    "sources": {
      "type": "array",
      "description": "Where facts came from. 'pending' entries mean the data is unverified.",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "name",
          "status"
        ],
        "properties": {
          "name": {
            "type": "string"
          },
          "url": {
            "type": "string"
          },
          "id": {
            "type": "string"
          },
          "status": {
            "enum": [
              "pending",
              "checked"
            ]
          }
        }
      }
    },
    "implementation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "type",
        "growth",
        "spawn"
      ],
      "properties": {
        "type": {
          "enum": [
            "flower_fruit_plant",
            "fruit_tree",
            "climbing_vine",
            "aquatic_plant"
          ],
          "description": "Generic Java class that implements the plant."
        },
        "behavior": {
          "type": "string",
          "description": "Optional id of a custom behavior hooked in by Java."
        },
        "growth": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "summary",
            "requirements"
          ],
          "properties": {
            "summary": {
              "type": "string"
            },
            "requirements": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "flowering": {
              "type": "string",
              "description": "How the flower stage is triggered and shown in game."
            },
            "pollination": {
              "type": "string"
            },
            "fruiting": {
              "type": "string"
            },
            "regrowth": {
              "type": "string"
            }
          }
        },
        "spawn": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "biomes",
            "feature"
          ],
          "properties": {
            "biomes": {
              "type": "array",
              "items": {
                "type": "string"
              },
              "description": "Minecraft biome or biome-tag ids."
            },
            "feature": {
              "enum": [
                "patch",
                "single",
                "tree",
                "underwater_patch",
                "vine_on_wall"
              ]
            },
            "rarity": {
              "enum": [
                "common",
                "uncommon",
                "rare",
                "very_rare"
              ]
            },
            "reason": {
              "type": "string",
              "description": "Why these biomes match the real habitat."
            }
          }
        },
        "drops": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "notes": {
          "type": "string"
        }
      }
    },
    "game_uses": {
      "type": "object",
      "description": "Filled in by the use phase only.",
      "additionalProperties": false,
      "properties": {
        "summary": {
          "type": "string"
        },
        "recipes": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "effects": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "based_on": {
          "type": "string",
          "description": "The real-world use this game use comes from."
        }
      }
    },
    "size": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "height_cm",
        "source"
      ],
      "description": "Real dimensions in centimetres. Block counts are derived from these by tools/derive_structure.py, never typed by hand.",
      "properties": {
        "height_cm": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "max"
          ],
          "properties": {
            "min": {
              "type": "number"
            },
            "max": {
              "type": "number"
            },
            "common_max": {
              "type": "number",
              "description": "Upper end of the commonly seen adult height when a source says larger sizes are rare. Most plants fall in [min, common_max]; a few reach max."
            }
          },
          "description": "Adult height range. Omit min if the source gives only a maximum."
        },
        "spread_cm": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "max"
          ],
          "description": "Adult width envelope: lowest minimum to highest maximum across spread_sources. Omitted when no source gives a width.",
          "properties": {
            "min": {
              "type": "number"
            },
            "max": {
              "type": "number"
            }
          }
        },
        "habit": {
          "enum": [
            "prostrate",
            "upright",
            "bushy",
            "sprawling",
            "climbing",
            "tree",
            "aquatic_tuft"
          ]
        },
        "source": {
          "enum": [
            "wikipedia",
            "gbif",
            "kew",
            "pending"
          ],
          "description": "'pending' means no figure was found in the fetched sources."
        },
        "quote": {
          "type": "string",
          "description": "The source wording the figures come from."
        },
        "spread_sources": {
          "type": "array",
          "description": "Every width figure found, kept separately because sources disagree (wild vs garden plants).",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "name",
              "url",
              "max",
              "quote"
            ],
            "properties": {
              "name": {
                "type": "string"
              },
              "url": {
                "type": "string"
              },
              "min": {
                "type": "number"
              },
              "max": {
                "type": "number"
              },
              "quote": {
                "type": "string"
              }
            }
          }
        },
        "trunk_diameter_cm": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "max"
          ],
          "properties": {
            "min": {
              "type": "number"
            },
            "max": {
              "type": "number"
            }
          },
          "description": "Trunk thickness for trees, used for how many blocks wide the trunk is."
        },
        "height_sources": {
          "type": "array",
          "description": "Every height figure found; the first entry is the primary botanical description. Individuals are drawn from the range these sources agree on.",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "name",
              "url",
              "max",
              "quote"
            ],
            "properties": {
              "name": {
                "type": "string"
              },
              "url": {
                "type": "string"
              },
              "min": {
                "type": "number"
              },
              "max": {
                "type": "number"
              },
              "common_max": {
                "type": "number"
              },
              "quote": {
                "type": "string"
              }
            }
          }
        }
      }
    },
    "segment_textures": {
      "type": "array",
      "description": "Extra textures for plants taller than one block at the configured scale. The stage textures are the TOP block; these are the blocks beneath it.",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "role",
          "texture",
          "note"
        ],
        "properties": {
          "role": {
            "enum": [
              "lower",
              "trunk_side",
              "trunk_top",
              "trunk_side_alt",
              "branch_side",
              "buttress_side"
            ]
          },
          "texture": {
            "type": "string"
          },
          "note": {
            "type": "string"
          }
        }
      }
    },
    "tree_structure": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "data_facts",
        "design"
      ],
      "description": "How a tree is built from blocks. data_facts are quoted from sources; design entries are choices NOT backed by data and are open to change.",
      "properties": {
        "data_facts": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "fact",
              "source"
            ],
            "properties": {
              "fact": {
                "type": "string"
              },
              "source": {
                "type": "string"
              }
            }
          }
        },
        "design": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "measurements": {
      "type": "array",
      "description": "Numeric facts with their units, each backed by a quote. Feeds size, multi-block growth and the sprite artist.",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "what",
          "unit",
          "max",
          "quote"
        ],
        "properties": {
          "what": {
            "enum": [
              "height",
              "spread",
              "trunk_diameter",
              "buttress_height",
              "branch_length",
              "root_depth",
              "leaf_length",
              "leaf_width",
              "flower_diameter",
              "flower_length",
              "fruit_length",
              "fruit_diameter",
              "seed_length",
              "lifespan",
              "age_to_first_flowering",
              "time_to_harvest",
              "flowering_duration",
              "bud_development_time",
              "crown_width",
              "crown_height",
              "bole_height",
              "branch_diameter",
              "internode_length",
              "petiole_length",
              "stem_diameter",
              "tiller_count",
              "branch_count",
              "inflorescence_length"
            ]
          },
          "unit": {
            "enum": [
              "cm",
              "years",
              "months",
              "weeks",
              "days",
              "count",
              "percent"
            ]
          },
          "min": {
            "type": "number"
          },
          "max": {
            "type": "number"
          },
          "qualifier": {
            "enum": [
              "range",
              "typical",
              "average",
              "maximum",
              "rare_maximum"
            ]
          },
          "quote": {
            "type": "string",
            "description": "Verbatim text from the source that supports this fact (checked by the pipeline)."
          },
          "source": {
            "type": "string",
            "description": "Which source the quote comes from, e.g. 'Wikipedia: Olive'."
          }
        }
      }
    },
    "appearance": {
      "type": "array",
      "description": "What each part looks like, for the sprite artist: colours, shapes, arrangement, texture, branching.",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "part",
          "attribute",
          "value",
          "quote"
        ],
        "properties": {
          "part": {
            "enum": [
              "whole_plant",
              "roots",
              "trunk",
              "bark",
              "branches",
              "twigs",
              "buds",
              "leaf",
              "flower",
              "inflorescence",
              "fruit",
              "seed"
            ]
          },
          "attribute": {
            "type": "string",
            "description": "color, shape, arrangement, texture, branching, habit, size ..."
          },
          "value": {
            "type": "string"
          },
          "stage": {
            "type": "string",
            "description": "Growth stage this applies to, if the source says (e.g. unripe, ripe, young)."
          },
          "quote": {
            "type": "string",
            "description": "Verbatim text from the source that supports this fact (checked by the pipeline)."
          },
          "source": {
            "type": "string",
            "description": "Which source the quote comes from, e.g. 'Wikipedia: Olive'."
          }
        }
      }
    },
    "phenology": {
      "type": "array",
      "description": "When things happen in the plant's year or life.",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "event",
          "when",
          "quote"
        ],
        "properties": {
          "event": {
            "enum": [
              "flowering",
              "fruiting",
              "ripening",
              "seed_release",
              "leaf_flush",
              "leaf_fall",
              "dormancy",
              "germination",
              "growth_rate"
            ]
          },
          "when": {
            "type": "string"
          },
          "quote": {
            "type": "string",
            "description": "Verbatim text from the source that supports this fact (checked by the pipeline)."
          },
          "source": {
            "type": "string",
            "description": "Which source the quote comes from, e.g. 'Wikipedia: Olive'."
          }
        }
      }
    },
    "propagation": {
      "type": "array",
      "description": "How the plant reproduces and regenerates (pollination, dispersal, germination, cuttings ...). Future-scope mechanics.",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "topic",
          "fact",
          "quote"
        ],
        "properties": {
          "topic": {
            "enum": [
              "pollination",
              "self_fertility",
              "seed_dispersal",
              "germination",
              "dormancy",
              "vegetative_propagation",
              "regeneration",
              "age_at_maturity",
              "lifespan",
              "cultivation",
              "toxicity"
            ]
          },
          "fact": {
            "type": "string"
          },
          "quote": {
            "type": "string",
            "description": "Verbatim text from the source that supports this fact (checked by the pipeline)."
          },
          "source": {
            "type": "string",
            "description": "Which source the quote comes from, e.g. 'Wikipedia: Olive'."
          }
        }
      }
    },
    "architecture": {
      "type": "array",
      "description": "How the plant is built: branching pattern, crown shape, leaf arrangement, stems and roots. Lets a tree get realistic branching and a small plant a realistic sprite.",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "aspect",
          "value",
          "quote"
        ],
        "properties": {
          "aspect": {
            "enum": [
              "growth_habit",
              "branching_pattern",
              "branch_angle",
              "branch_droop",
              "crown_shape",
              "canopy_density",
              "trunk_form",
              "bark_form",
              "twig_form",
              "stem_type",
              "leaf_arrangement",
              "leaf_shape",
              "leaf_margin",
              "tillering",
              "climbing_mechanism",
              "root_system",
              "buttresses",
              "pruning_response",
              "multiple_trunks",
              "flower_arrangement",
              "fruit_arrangement"
            ]
          },
          "value": {
            "type": "string"
          },
          "stage": {
            "type": "string"
          },
          "quote": {
